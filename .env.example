APP_NAME=PickSell
# Production: APP_ENV=production and APP_DEBUG=false (see .env.production.example).
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# This API's address. The Android emulator reaches the PC's localhost through 10.0.2.2.
APP_URL=http://10.0.2.2:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# The PickSell website's database: this app reads and writes the website's tables.
# Create or update them with the website's migrations (php artisan migrate in the PickSell
# project); this app's own `php artisan migrate` only adds the login-token table.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=picksell
# Least-privilege user limited to the picksell schema — never root.
DB_USERNAME=picksell_app
DB_PASSWORD=
# Same as the website (leave empty unless the website sets it too).
DB_TIMEZONE=

# Keep cache and jobs out of the website's tables.
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# The website's public storage folder and its URL (product photos, ID uploads, evidence).
PICKSELL_PUBLIC_STORAGE_ROOT=C:\projects\PickSell\PickSell\storage\app\public
PICKSELL_PUBLIC_STORAGE_URL=http://127.0.0.1:8000/storage

# Must equal the website's PLATFORM_COMMISSION_RATE.
PLATFORM_COMMISSION_RATE=10

# App login lifetime in minutes (default 30 days).
SANCTUM_EXPIRATION=43200

# Dev: verification codes are written to storage/logs/laravel.log.
# Production: the website's SMTP account (MAIL_MAILER=smtp, MAIL_HOST, …).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@picksell.local
MAIL_FROM_NAME="${APP_NAME}"
