APP_NAME=PickSell
# Production: APP_ENV=production and APP_DEBUG=false (debug pages leak
# stack traces, queries and environment values).
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Android emulator reaches the PC's localhost through 10.0.2.2.
# Production: the public https:// URL.
APP_URL=http://10.0.2.2:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=picksell
# Least-privilege user limited to the picksell schema — never root.
DB_USERNAME=picksell_app
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=file
# Production (HTTPS): send session cookies over TLS only.
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public

# Mobile API token lifetime in minutes (default 30 days).
SANCTUM_EXPIRATION=43200

# Flat per-checkout platform fee in PHP (0 hides it).
PICKSELL_SERVICE_FEE=0

# ── Finance (documentation/finance-returns-payouts.md) ──────────────────
# Rider pay: unconfigured | proposed | active. Only "active" accrues pay,
# and only after the rates are approved. Amounts in pesos.
PICKSELL_RIDER_PAY_STATUS=unconfigured
PICKSELL_RIDER_PAY_BASE_PER_STOP=
PICKSELL_RIDER_PAY_ADDITIONAL_PARCEL=
PICKSELL_RIDER_PAY_FAILED_ATTEMPT=
# RR 16-2023 withholding: keep false until reviewed by a tax professional.
PICKSELL_WITHHOLDING_ENABLED=false
PICKSELL_PAYOUT_PERIOD=weekly
PICKSELL_PLATFORM_VOUCHER_FUNDED_BY=platform
# Two-person payout approval, for payouts at or above the threshold (pesos).
PICKSELL_PAYOUT_SECOND_ADMIN=false
PICKSELL_PAYOUT_SECOND_ADMIN_THRESHOLD=0
# Returns and deliveries.
PICKSELL_DEFECT_CLAIM_DAYS=60
PICKSELL_MAX_DELIVERY_ATTEMPTS=3

# Dev: verification codes are written to storage/logs/laravel.log.
# Production: configure real SMTP (MAIL_MAILER=smtp, MAIL_HOST, …).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@picksell.local
MAIL_FROM_NAME="${APP_NAME}"
