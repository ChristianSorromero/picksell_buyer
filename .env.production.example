# Production settings for Picksell. See documentation/deployment.md §2.
#
# Commit this template, never a filled-in copy. Values marked SECRET go in
# the hosting platform's environment or secret store, not in any file in
# the repository. Run `php artisan picksell:preflight` after setting them.

APP_NAME=PickSell
APP_ENV=production
APP_DEBUG=false
# SECRET. Generate once on the server (php artisan key:generate --show) and
# keep it; changing it logs everyone out and breaks encrypted values.
APP_KEY=
# The public site, https only (also the base of the mobile API URL).
APP_URL=https://CHANGE-ME.example
# Storage stays UTC; pages, reports and the scheduler use Philippine time.
APP_DISPLAY_TIMEZONE=Asia/Manila
APP_SCHEDULE_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=CHANGE-ME
DB_PORT=3306
DB_DATABASE=picksell
# Least-privilege account limited to this schema. Never root.
DB_USERNAME=picksell_app
# SECRET
DB_PASSWORD=
# Pin MySQL sessions to UTC from the first deploy (TIMESTAMP columns).
DB_TIMEZONE=+00:00

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
# Mail goes out through a worker (php artisan queue:work), not inside requests.
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# Mobile API token lifetime in minutes (30 days).
SANCTUM_EXPIRATION=43200

# A real SMTP provider. With "log", buyers never receive verification or
# password reset codes.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE-ME
MAIL_PORT=587
# SECRET (both)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@CHANGE-ME.example
MAIL_FROM_NAME="${APP_NAME}"

PICKSELL_SERVICE_FEE=0

# Finance: safe defaults until each policy is approved
# (documentation/finance-returns-payouts.md).
PICKSELL_RIDER_PAY_STATUS=unconfigured
PICKSELL_RIDER_PAY_BASE_PER_STOP=
PICKSELL_RIDER_PAY_ADDITIONAL_PARCEL=
PICKSELL_RIDER_PAY_FAILED_ATTEMPT=
PICKSELL_WITHHOLDING_ENABLED=false
PICKSELL_PAYOUT_PERIOD=weekly
PICKSELL_PLATFORM_VOUCHER_FUNDED_BY=platform
PICKSELL_PAYOUT_SECOND_ADMIN=false
PICKSELL_PAYOUT_SECOND_ADMIN_THRESHOLD=0
PICKSELL_DEFECT_CLAIM_DAYS=60
PICKSELL_MAX_DELIVERY_ATTEMPTS=3
