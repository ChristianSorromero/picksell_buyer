# Production settings for the PickSell buyer app API. See documentation/deployment.md.
#
# This server shares the PickSell website's database and uploaded files, and runs on the same
# machine as the website. Commit this template, never a filled-in copy. Values marked SECRET go
# in the server's environment, not in the repository. Run `php artisan picksell:preflight` after
# setting them.

APP_NAME=PickSell
APP_ENV=production
APP_DEBUG=false
# SECRET. Generate once on the server (php artisan key:generate --show) and keep it.
APP_KEY=
# This API's public address (the app is built with API_BASE_URL=${APP_URL}/api).
APP_URL=https://api.pick-sell.shop
APP_DISPLAY_TIMEZONE=Asia/Manila
APP_SCHEDULE_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# The SAME database the website uses (copy these from the website's .env).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=picksell
# Never root.
DB_USERNAME=picksell_app
# SECRET
DB_PASSWORD=
# Leave empty, like the website: both must read and write TIMESTAMP columns in the same
# MySQL session time zone, or the same moment is stored hours apart.
DB_TIMEZONE=

# Keep cache and jobs out of the website's tables: file cache, mail sent during the request.
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# The website's public storage (product photos, ID uploads, return evidence).
PICKSELL_PUBLIC_STORAGE_ROOT=C:\path\to\PickSell\storage\app\public
PICKSELL_PUBLIC_STORAGE_URL=https://pick-sell.shop/storage

# Must equal the website's PLATFORM_COMMISSION_RATE.
PLATFORM_COMMISSION_RATE=10

# App login lifetime in minutes (30 days).
SANCTUM_EXPIRATION=43200

# The same mail account the website uses, so verification and reset codes arrive.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE-ME
MAIL_PORT=587
# SECRET (both)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@pick-sell.shop
MAIL_FROM_NAME="${APP_NAME}"
